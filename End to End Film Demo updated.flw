-4878-80c6-b14118aea2fc|Input tables 1|Input tables","UI_PROP_NODE_DATA_ID":"ab59f8c4-af9a-4608-a5d5-a8365357bb99","UI_PROP_NODE_DATA_MODIFIED_DATE":"1702906135258","UI_PROP_PORT_ID|outTables|0":"9d363053-abfa-406f-8758-0471ac698903","UI_PROP_PORT_LABEL|outTables|0":"Output tables 1","UI_PROP_PORT_DESCRIPTION|outTables|0":"Output tables"},"portMappings":[{"mappingType":"tableStructure","portName":"outTables","portIndex":0,"tableStructure":{"columnDefinitions":[{"name":"Rank","index":0,"type":"Numeric","rawLength":8,"formattedLength":0,"version":2,"links":[],"attributes":{}},{"name":"Title","index":1,"type":"Char","rawLength":62,"formattedLength":0,"version":2,"links":[],"attributes":{}},{"name":"Worldwide Lifetime Gross","index":2,"type":"Char","rawLength":14,"formattedLength":0,"version":2,"links":[],"attributes":{}},{"name":"Domestic Lifetime Gross","index":3,"type":"Char","rawLength":12,"formattedLength":0,"version":2,"links":[],"attributes":{}},{"name":"Domestic %","index":4,"type":"Char","rawLength":5,"formattedLength":0,"version":2,"links":[],"attributes":{}},{"name":"Foreign Lifetime Gross","index":5,"type":"Char","rawLength":14,"formattedLength":0,"version":2,"links":[],"attributes":{}},{"name":"Foreign %","index":6,"type":"Char","rawLength":5,"formattedLength":0,"version":2,"links":[],"attributes":{}},{"name":"Year","index":7,"type":"Numeric","rawLength":8,"formattedLength":0,"version":2,"links":[],"attributes":{}},{"name":"links","index":8,"type":"Char","rawLength":40,"formattedLength":0,"version":2,"links":[],"attributes":{}},{"name":"tconst","index":9,"type":"Char","rawLength":10,"formattedLength":0,"version":2,"links":[],"attributes":{}}]}}],"stepReference":{"type":"uri","path":"/dataFlows/steps/ab59f8c4-af9a-4608-a5d5-a8365357bb99"},"arguments":{"codeOptions":{"code":"from bs4 import BeautifulSoup as bs\nimport requests\nimport pandas as pd\nimport os\nimport re\n#Neat way of storing all the web pages into a single list\n#Then looping around each of them in turn\n#First define the lists needed, one for tables and one for links\ndfs=[]\nl = []\n#Create a list with all the required pages\nweblist=[\"https://www.boxofficemojo.com/chart/ww_top_lifetime_gross/?area=XWW&ref_=bo_cso_ac\",\n\"https://www.boxofficemojo.com/chart/ww_top_lifetime_gross/?area=XWW&offset=200\",\n\"https://www.boxofficemojo.com/chart/ww_top_lifetime_gross/?area=XWW&offset=400\",\n\"https://www.boxofficemojo.com/chart/ww_top_lifetime_gross/?area=XWW&offset=600\",\n\"https://www.boxofficemojo.com/chart/ww_top_lifetime_gross/?area=XWW&offset=800\"]\n\n#Loop round each page and extract the table and links\n#This creates a list of lists for the tables and a single list for the links.\nfor i in weblist:\n    #get the page\n    page=requests.get(i)\n    #turn the page into soup\n    soup=bs(page.content,'html')\n    #gets the table from the soup\n    dfs.append(pd.read_html(str(soup.table))[0])\n    #gets all the links from the soup with title as their name\n    links=soup.find_all(\"a\",attrs ={\"href\" : re.compile(\"title\")})\n    #puts all the links into a list.\n    for link in links:\n        l.append(link.get('href'))\n\n#converts the link list into a dataframe\nall_links = pd.DataFrame(l,columns=[\"links\"])\n#concatonate each film table list into a single dataframe\nall_films = pd.concat(dfs)\n#reset the index after concatonation\nall_films.reset_index(inplace = True, drop=True)\n#Bring the information together\nall_films[\"links\"]=all_links[\"links\"]\n#create the join variable tconst\nall_films['tconst'] = all_films['links'].str.split('/').str[2]\nSAS.df2sd(all_films, 'work.allfilms_link')","logHTML":"","resultsHTML":"","variables":[{"name":"_output1","value":{"referenceType":"outputPort","portName":"outTables","portIndex":0,"arguments":{}}},{"name":"_input1","value":{"referenceType":"inputPort","portName":"inTables","portIndex":0}}],"contentType":"embedded"}}},"id-1706539370428-25414":{"nodeType":"outputTable","version":1,"id":"id-17065