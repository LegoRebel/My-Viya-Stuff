,"formattedLength":0,"version":2,"links":[],"attributes":{}},{"name":"Title","index":8,"type":"Char","rawLength":68,"formattedLength":0,"version":2,"links":[],"attributes":{}},{"name":"US_pct","index":9,"type":"Numeric","rawLength":8,"formattedLength":0,"version":2,"links":[],"attributes":{}},{"name":"US_Lifetime_Gross","index":10,"type":"Numeric","rawLength":8,"formattedLength":0,"version":2,"links":[],"attributes":{}},{"name":"Rest_world_pct","index":11,"type":"Numeric","rawLength":8,"formattedLength":0,"version":2,"links":[],"attributes":{}},{"name":"Rest_world_Lifetime_Gross","index":12,"type":"Numeric","rawLength":8,"formattedLength":0,"version":2,"links":[],"attributes":{}},{"name":"Worldwide_Lifetime_Gross","index":13,"type":"Numeric","rawLength":8,"formattedLength":0,"version":2,"links":[],"attributes":{}}]}}],"stepReference":{"type":"uri","path":"/dataFlows/steps/ab59f8c4-af9a-4608-a5d5-a8365357bb99"},"arguments":{"codeOptions":{"code":"from bs4 import BeautifulSoup as bs\nimport pandas as pd\nimport requests\n\ndf=SAS.sd2df(\"IMDB.best_not_bo\")\n#Takes in dataframe from SAS. It will create a dataframe with all the info at the end.\n#Creates empty dataframe. if not included, it just keeps getting bigger\nsi=pd.DataFrame()\n#Looop round each row in df. need to change name of START and film.\nfor index, row in df.iterrows():\n\tlinks=\"https://www.boxofficemojo.com/title/\"+row['tconst']+\"/?ref_=bo_se_r_1\"\n\tpage=requests.get(links)\n\tsoup=bs(page.content,'html')\n\ttable=soup.find(\"div\", { \"class\" : \"a-section a-spacing-none mojo-performance-summary-table\" })\n\ttext=(table.get_text(separator=' ',strip=True).split(' '))\n    #need to add all the columns that were in the the dataframe brought over.\n    #need to check column names and add all the others like runtime, genres, numvotes and averagerating\n\tif text[3] ==\"(\" :\n\t\tdata = {'tconst': row['tconst'],\n\t\t'genres':row['genres'],\n\t\t'averageRating':row['averageRating'],\n\t\t'numVotes':row['numVotes'],\n\t\t'runtimeMinutes':row['runtimeMinutes'],\n\t\t'decade':row['decade'],\n\t\t'Year':row['Year'],\n\t\t'links':links,\n\t\t'Title':row['Title'],\n\t\t'US_pct': float(text[4].replace(\"%\", \"\").replace(\"–\", \"0\"))/100,\n\t\t'US_Lifetime_Gross':int(text[6].replace(\"–\", \"0\").replace(\"$\", \"\").replace(\",\", \"\")),\n\t\t'Rest_world_pct': float(text[9].replace(\"%\", \"\").replace(\"–\", \"0\"))/100,\n\t\t'Rest_world_Lifetime_Gross': int(text[11].replace(\"$\", \"\").replace(\",\", \"\").replace(\"–\", \"0\")),\n\t\t'Worldwide_Lifetime_Gross': int(text[13].replace(\"$\", \"\").replace(\",\", \"\"))}\n\n\t\tsi = si._append(data,ignore_index=True)\n    \nSAS.df2sd(si,'IMDB.best_film')\n","logHTML":"","resultsHTML":"","variables":[{"name":"_input1","value":{"referenceType":"inputPort","portName":"inTables","portIndex":0}},{"name":"_output1","value":{"referenceType":"outputPort","portName":"outTables","portIndex":0,"arguments":{}}}],"contentType":"embedded"}}},"id-1708440160904-112146":{"nodeType":"outputTable","version":1,"id":"id-1708440160904-112146","name":"BEST_FILM","note":{"version":1,"id":"id-1708440160904-112150","name":null,"description":null,"properties":{"UI_NOTE_PROP_IS_EXPANDED":"false","UI_NOTE_PROP_HEIGHT":"0","UI_NOTE_PROP_WIDTH":"0","UI_NOTE_PROP_IS_STICKYNOTE":"false"}},"priority":25,"properties":{"UI_PROP_TABLE_URI":"SASData://WORK?BEST_FILM","UI_PROP_XPOS":"656","UI_PROP_YPOS":"360","UI_PROP_COLORGRP":"0","UI_PROP_IS_INPUT_EXPANDED":"false","UI_PROP_IS_OUTPUT_EXPANDED":"false","UI_PROP_USE_PERSISTED_TABLE_STRUCTURE":"false","UI_PROP_NODE_DATA_ID":"table","UI_PROP_PORT_ID|inTable|0":"b6d3cf2d-1210-4c6e-bf92-2540283ae81b","UI_PROP_PORT_LABEL|inTable|0":null,"UI_PROP_PORT_DESCRIPTION|inTable|0":null,"UI_PROP_PORT_ID|outTable|0":"e05957e7-4399-4cce-8193-aafb00ce7e72","UI_PROP_PORT_LABEL|outTable|0":null,"UI_PROP_PORT_DESCRIPTION|outTable|0":null},"tableReference":{"referenceType":"parameter","parameterId":"id-1708440160904-112