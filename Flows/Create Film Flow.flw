/title.ratings.tsv.gz\"\r\nin_file=\"title.ratings.tsv.gz\"\r\nout_file=SAS.symget('path')+\"/title_ratings.tsv\"\r\nwith open (in_file, \"wb\") as f:\r\n    f.write(requests.get(URL).content)\r\nwith gzip.open(in_file, 'rb') as infile:\r\n    with open(out_file, 'wb') as outfile:\r\n        shutil.copyfileobj(infile,outfile)\r\n\r\nURL = \"https://datasets.imdbws.com/title.basics.tsv.gz\"\r\nin_file=\"title.ratings.tsv.gz\"\r\nout_file=SAS.symget('path')+\"/title.tsv\"\r\nwith open (in_file, \"wb\") as f:\r\n    f.write(requests.get(URL).content)\r\nwith gzip.open(in_file, 'rb') as infile:\r\n    with open(out_file, 'wb') as outfile:\r\n        shutil.copyfileobj(infile,outfile)\r\n\r\nURL = \"https://datasets.imdbws.com/title.crew.tsv.gz\"\r\nin_file=\"title.ratings.tsv.gz\";\r\nout_file=SAS.symget('path')+\"/crew.tsv\";\r\nwith open (in_file, \"wb\") as f:\r\n    f.write(requests.get(URL).content)\r\nwith gzip.open(in_file, 'rb') as infile:\r\n    with open(out_file, 'wb') as outfile:\r\n        shutil.copyfileobj(infile,outfile)\r\n\r\nURL = \"https://datasets.imdbws.com/title.principals.tsv.gz\"\r\nin_file=\"title.ratings.tsv.gz\";\r\nout_file=SAS.symget('path')+\"/principals.tsv\";\r\nwith open (in_file, \"wb\") as f:\r\n    f.write(requests.get(URL).content)\r\nwith gzip.open(in_file, 'rb') as infile:\r\n    with open(out_file, 'wb') as outfile:\r\n        shutil.copyfileobj(infile,outfile)\r\n\r\n\r\nURL = \"https://datasets.imdbws.com/name.basics.tsv.gz\"\r\nin_file=\"title.ratings.tsv.gz\";\r\nout_file=SAS.symget('path')+\"/name.tsv\";\r\nwith open (in_file, \"wb\") as f:\r\n    f.write(requests.get(URL).content)\r\nwith gzip.open(in_file, 'rb') as infile:\r\n    with open(out_file, 'wb') as outfile:\r\n        shutil.copyfileobj(infile,outfile)","contentType":"embedded","variables":[{"name":"_input1","value":{"portIndex":0,"portName":"inTables","referenceType":"inputPort"}},{"name":"_output1","value":{"arguments":{},"portIndex":0,"portName":"outTables","r