me":"inTables","referenceType":"inputPort"}},{"name":"_output1","value":{"arguments":{},"portIndex":0,"portName":"outTables","referenceType":"outputPort"}},{"name":"_input2","value":{"portIndex":1,"portName":"inTables","referenceType":"inputPort"}}]}},"stepReference":{"type":"uri","path":"/dataFlows/steps/a7190700-f59c-4a94-afe2-214ce639fcde"}},"13d4b1d0-5363-11f1-b263-3f5652342f9a":{"id":"13d4b1d0-5363-11f1-b263-3f5652342f9a","name":"find revenue","nodeType":"step","priority":9,"properties":{"UI_PROP_INPUT_PORT|inTables|0":"|Input table 1|Input tables","UI_PROP_IS_INPUT_EXPANDED":"false","UI_PROP_IS_OUTPUT_EXPANDED":"false","UI_PROP_LOCATION":"478.6666564941406 265.31781005859375","UI_PROP_OUTPUT_PORT|outTables|0":"|Output table 1|Output tables"},"portMappings":[{"portName":"outTables","mappingType":"tableStructure","tableStructure":{"columnDefinitions":[{"version":2,"name":"tconst","index":0,"type":"Char","rawLength":10,"formattedLength":0,"indexed":false,"format":{"length":0,"decimals":0},"informat":{"length":0,"decimals":0}},{"version":2,"name":"Title","index":1,"type":"Char","rawLength":68,"formattedLength":0,"indexed":false,"format":{"length":0,"decimals":0},"informat":{"length":0,"decimals":0}},{"version":2,"name":"Year","index":2,"type":"Numeric","rawLength":8,"formattedLength":0,"indexed":false,"format":{"length":0,"decimals":0},"informat":{"length":0,"decimals":0}},{"version":2,"name":"genres","index":3,"type":"Char","rawLength":27,"formattedLength":0,"indexed":false,"format":{"length":0,"decimals":0},"informat":{"length":0,"decimals":0}},{"version":2,"name":"averageRating","index":4,"type":"Numeric","rawLength":8,"formattedLength":0,"indexed":false,"format":{"length":0,"decimals":0},"informat":{"length":0,"decimals":0}},{"version":2,"name":"numVotes","index":5,"type":"Numeric","rawLength":8,"formattedLength":0,"indexed":false,"format":{"length":0,"decimals":0},"informat":{"length":0,"decimals":0}},{"version":2,"name":"runtimeMinutes","index":6,"type":"Numeric","rawLength":8,"formattedLength":0,"indexed":false,"format":{"length":0,"decimals":0},"informat":{"length":0,"decimals":0}},{"version":2,"name":"Decade","index":7,"type":"Numeric","rawLength":8,"formattedLength":0,"indexed":false,"format":{"length":0,"decimals":0},"informat":{"length":0,"decimals":0}},{"version":2,"name":"link","index":8,"type":"Char","rawLength":62,"formattedLength":0,"indexed":false,"format":{"length":0,"decimals":0},"informat":{"length":0,"decimals":0}},{"version":2,"name":"US_pct","index":9,"type":"Numeric","rawLength":8,"formattedLength":0,"indexed":false,"format":{"length":0,"decimals":0},"informat":{"length":0,"decimals":0}},{"version":2,"name":"US_Lifetime_Gross","index":10,"type":"Numeric","rawLength":8,"formattedLength":0,"indexed":false,"format":{"length":0,"decimals":0},"informat":{"length":0,"decimals":0}},{"version":2,"name":"Rest_world_pct","index":11,"type":"Numeric","rawLength":8,"formattedLength":0,"indexed":false,"format":{"length":0,"decimals":0},"informat":{"length":0,"decimals":0}},{"version":2,"name":"Rest_world_Lifetime_Gross","index":12,"type":"Numeric","rawLength":8,"formattedLength":0,"indexed":false,"format":{"length":0,"decimals":0},"informat":{"length":0,"decimals":0}},{"version":2,"name":"Worldwide_Lifetime_Gross","index":13,"type":"Numeric","rawLength":8,"formattedLength":0,"indexed":false,"format":{"length":0,"decimals":0},"informat":{"length":0,"decimals":0}}]}}],"arguments":{"codeOptions":{"code":"from bs4 import BeautifulSoup\r\nimport pandas as pd\r\nimport requests\r\nfrom typing import Optional\r\n\r\nBASE_URL = \"https://www.boxofficemojo.com/title/{}/?ref_=bo_se_r_1\"\r\n\r\n# Reuse session (faster)\r\nsession = requests.Session()\r\nsession.headers.update({\"User-Agent\": \"Mozilla/5.0\"})\r\n\r\n\r\ndef clean_money(value: str) -> int:\r\n    if not value or value.strip() in [\"-\", \"â€“\"]:\r\n        return 0\r\n    return int(value.replace(\"$\", \"\").replace(\",\", \"\").strip())\r\n\r\n\r\ndef clean_pct(value: str) -> float:\r\n    if not value or value.strip() in [\"-\", \"\"]:\r\n        return 0.0\r\n    return float(value.replace(\"%\", \"\").strip())\r\n\r\n\r\ndef parse_box_office(tconst: str) -> Optional[dict]:\r\n    url = BASE_URL.format(tconst)\r\n\r\n    try:\r\n        response = session.get(url, timeout=10)\r\n        response.raise_for_status()\r\n    except requests.RequestException:\r\n        return None\r\n\r\n    soup = BeautifulSoup(response.content, \"html.parser\")\r\n\r\n    summary = soup.find(\r\n        \"div\",\r\n        class_=\"a-section a-spacing-none mojo-performance-summary-table\"\r\n    )\r\n\r\n    if not summary:\r\n        return None\r\n\r\n    data = {\r\n        \"link\": url,\r\n        \"US_pct\": None,\r\n        \"US_Lifetime_Gross\": None,\r\n        \"Rest_world_pct\": None,\r\n        \"Rest_world_Lifetime_Gross\": None,\r\n        \"Worldwide_Lifetime_Gross\": None\r\n    }\r\n\r\n    # ✅ KEY CHANGE: parse rows instead of splitting text\r\n    rows = summary.find_all(\"div\", recursive=False)\r\n\r\n    for row in rows:\r\n        text = row.get_text(\" \", strip=True)\r\n\r\n        # Domestic\r\n        if \"Domestic\" in text:\r\n            parts = text.split()\r\n            for p in parts:\r\n                if \"$\" in p:\r\n                    data[\"US_Lifetime_Gross\"] = clean_money(p)\r\n                if \"%\" in p:\r\n                    data[\"US_pct\"] = clean_pct(p)\r\n\r\n        # International\r\n        elif \"International\" in text:\r\n            parts = text.split()\r\n            for p in parts:\r\n                if \"$\" in p:\r\n                    data[\"Rest_world_Lifetime_Gross\"] = clean_money(p)\r\n                if \"%\" in p:\r\n                    data[\"Rest_world_pct\"] = clean_pct(p)\r\n\r\n        # Worldwide\r\n        elif \"Worldwide\" in text:\r\n            parts = text.split()\r\n            for p in parts:\r\n                if \"$\" in p:\r\n                    data[\"Worldwide_Lifetime_Gross\"] = clean_money(p)\r\n\r\n    return data\r\n\r\n\r\ndef rev_get(df: pd.DataFrame) -> pd.DataFrame:\r\n    results = []\r\n\r\n    for row in df.itertuples(index=False):\r\n        scraped = parse_box_office(row.tconst)\r\n        base = row._asdict()\r\n\r\n        if scraped:\r\n            results.append({**base, **scraped})\r\n        else:\r\n            results.append({\r\n                **base,\r\n                \"link\": None,\r\n                \"US_pct\": None,\r\n                \"US_Lifetime_Gross\": None,\r\n                \"Rest_world_pct\": None,\r\n                \"Rest_world_Lifetime_Gross\": None,\r\n                \"Worldwide_Lifetime_Gross\": None\r\n            })\r\n\r\n    return pd.DataFrame(results)\r\n\r\n\r\n\r\n\r\ndf_in = SAS.sasdata2dataframe('WORK.BEST_NOT_BO')\r\ndf_out = rev_get(df_in)\r\nSAS.df2sd(df_out, \"imdb.Best_Film\");\r\n","contentType":"embedded","variables":[{"name":"_input1","value":{"portIndex":0,"portName":"inTables","referenceType":"inputPort"}},{"name":"_output1","value":{"arguments":{},"portIndex":0,"portName":"outTables","referenceType":"outputPort"}}]}},"stepReference":{"type":"uri","path":"/dataFlows/steps/ab59f8c4-af9a-4608-a5d5-a8365357bb99"}},"27f08d60-5363-11f1-b263-3f5652342f9a":{"id":"27f08d60-5363-11f1-b263-3f5652342f9a","name":"BEST_FILM","nodeType":"outputTable","priority":8,"properties":{"UI_PROP_INPUT_PORT|inTable|0":"|inTable|","UI_PROP_LOCATION":"603.6666564941406 264.31781005859375","UI_PROP_OUTPUT_PORT|outTable|0":"|outTable|","usePersistedTableStructure":"false"},"tableReference":{"referenceType":"parameter","parameterId":"27f08d60-5363-11f1-b263-3f5652342f9a"},"outputTableArguments":{}},"332642a0-535f-11f1-b263-3f5652342f9a":{"id":"332642a0-535f-11f1-b263-3f5652342f9a","name":"Query 3","nodeType":"step","priority":7,"properties":{"UI_PROP_INPUT_PORT|inTables|0":"|Input table 1|Query input tables","UI_PROP_INPUT_PORT|inTables|1":"|Input table 2|Query input ta