onseType":"application/vnd.sas.summary"}],"version":4,"sourceVersion":2,"nodes":{"6800da30-2461-11f1-8c2e-4b25bc84b893":{"id":"6800da30-2461-11f1-8c2e-4b25bc84b893","name":"Get Box Office Data","nodeType":"dataFlow","priority":0,"properties":{"UI_PROP_IS_EXPANDED":"false","UI_PROP_LOCATION":"0 36.338623046875"},"dataFlowAndBindings":{"dataFlow":{"creationTimeStamp":"2026-10-20T13:56:44.721Z","modifiedTimeStamp":"2026-10-20T13:56:44.721Z","properties":{"UI_PROP_DF_EXECUTION_ORDERED":"true","UI_PROP_DF_OPTIMIZE":"false"},"version":4,"sourceVersion":2,"nodes":{"37048720-2460-11f1-8c2e-4b25bc84b893":{"id":"37048720-2460-11f1-8c2e-4b25bc84b893","name":"Read in 1000 Films ","nodeType":"step","priority":2,"properties":{"UI_PROP_INPUT_PORT|inTables|0":"|Input table 1|Input tables","UI_PROP_IS_INPUT_EXPANDED":"false","UI_PROP_IS_OUTPUT_EXPANDED":"false","UI_PROP_LOCATION":"122.77839805146775 146.56590662650805","UI_PROP_OUTPUT_PORT|outTables|0":"|Output table 1|Output tables"},"portMappings":[{"portName":"outTables","mappingType":"tableStructure","tableStructure":{"columnDefinitions":[{"version":2,"name":"Rank","index":0,"type":"Char","rawLength":5,"formattedLength":0,"indexed":false},{"version":2,"name":"Title","index":1,"type":"Char","rawLength":66,"formattedLength":0,"indexed":false},{"version":2,"name":"Worldwide Lifetime Gross","index":2,"type":"Char","rawLength":14,"formattedLength":0,"indexed":false},{"version":2,"name":"Domestic Lifetime Gross","index":3,"type":"Char","rawLength":12,"formattedLength":0,"indexed":false},{"version":2,"name":"Domestic %","index":4,"type":"Char","rawLength":5,"formattedLength":0,"indexed":false},{"version":2,"name":"Foreign Lifetime Gross","index":5,"type":"Char","rawLength":14,"formattedLength":0,"indexed":false},{"version":2,"name":"Foreign %","index":6,"type":"Char","rawLength":6,"formattedLength":0,"indexed":false},{"version":2,"name":"Year","index":7,"type":"Char","rawLength":4,"formattedLength":0,"indexed":false},{"version":2,"name":"links","index":8,"type":"Char","rawLength":40,"formattedLength":0,"indexed":false},{"version":2,"name":"tconst","index":9,"type":"Char","rawLength":10,"formattedLength":0,"indexed":false}]}}],"arguments":{"codeOptions":{"code":"from bs4 import BeautifulSoup as bs\r\nimport requests\r\nimport pandas as pd\r\nimport re\r\n\r\ndfs = []\r\nlinks_all = []\r\n\r\nweblist = [\r\n    \"https://www.boxofficemojo.com/chart/ww_top_lifetime_gross/?area=XWW\",\r\n    \"https://www.boxofficemojo.com/chart/ww_top_lifetime_gross/?area=XWW&offset=200\",\r\n    \"https://www.boxofficemojo.com/chart/ww_top_lifetime_gross/?area=XWW&offset=400\",\r\n    \"https://www.boxofficemojo.com/chart/ww_top_lifetime_gross/?area=XWW&offset=600\",\r\n    \"https://www.boxofficemojo.com/chart/ww_top_lifetime_gross/?area=XWW&offset=800\"\r\n]\r\n\r\nfor url in weblist:\r\n    page = requests.get(url)\r\n    soup = bs(page.content, \"html.parser\")\r\n\r\n    table = soup.find(\"table\")\r\n    rows = table.find_all(\"tr\")\r\n\r\n    headers = [th.get_text(strip=True) for th in rows[0].find_all(\"th\")]\r\n    data = []\r\n\r\n    for row in rows[1:]:\r\n        cols = row.find_all(\"td\")\r\n        if not cols:\r\n            continue\r\n\r\n        row_data = [c.get_text(strip=True) for c in cols]\r\n        data.append(row_data)\r\n\r\n        # Extract movie link\r\n        a = row.find(\"a\", href=re.compile(\"/title/\"))\r\n        links_all.append(a[\"href\"] if a else None)\r\n\r\n    df = pd.DataFrame(data, columns=headers)\r\n    dfs.append(df)\r\n\r\n# Combine all pages\r\nall_films = pd.concat(dfs, ignore_index=True)\r\n\r\n# Add links\r\nall_films[\"links\"] = links_all\r\n\r\n# Extract tconst (IMDB id)\r\nall_films[\"tconst\"] = all_films[\"links\"].str.split(\"/\").str[2]\r\n\r\n# Send to SAS\r\nSAS.df2sd(all_films, \"work.allfilms_link\")","contentType":"embedded","variables":[{"name":"_input1","value":{"portIndex":0,"portName":"inTables","referenceType":"inputPort"}},{"name":"_output1","value":{"arguments":{},"portIndex":0,"portName":"outTables","referenceType":"outputPort"}}]}},"stepReference":{"type":"uri","path":"/dataFlows/steps/ab59f8c4-af9a-4608-a5d5-a8365357bb99"}},"3ce1fe20-2460-11f1-8c2e-4b25bc84b893":{"id":"3ce1fe20-2460-11f1-8c2e-4b25bc84b893","name":"ALLFILMS_LINK","nodeType":"outputTable","priority":1,"properties":{"UI_PROP_INPUT_PORT|inTable|0":"|inTable|","UI_PROP_LOCATION":"247.77839805146778 145.56590662650805","UI_PROP_OUTPUT_PORT|outTable|0":"|outTable|","usePersistedTableStructure":"false"},"tableReference":{"referenceType":"parameter","parameterId":"3ce1fe20-2460-11f1-8c2e-4b25bc84b893"},"outputTableArguments":{}},"4b691990-2462-11f1-8c2e-4b25bc84b893":{"id":"4b691990-2462-11f1-8c2e-4b25bc84b893","name":"BOX_OFFICE_1000_FINAL","nodeType":"outputTable","priority":3,"properties":{"UI_PROP_INPUT_PORT|inTable|0":"|inTable|","UI_PROP_LOCATION":"526.5221859141373 148.60804053176253","UI_PROP_OUTPUT_PORT|outTable|0":"|outTable|","usePersistedTableStructure":"false"},"tableReference":{"referenceType":"parameter","parameterId":"4b691990-2462-11f1-8c2e-4b25bc84b893"},"outputTableArguments":{}},"6fc9a670-2461-11f1-8c2e-4b25bc84b893":{"id":"6fc9a670-2461-11f1-8c2e-4b25bc84b893","name":"Set the path","nodeType":"step","priority":0,"properties":{"UI_PROP_INPUT_PORT|inTables|0":"|Input table 1|Input tables","UI_PROP_IS_INPUT_EXPANDED":"false","UI_PROP_IS_OUTPUT_EXPANDED":"false","UI_PROP_LOCATION":"65 63.338623046875","UI_PROP_OUTPUT_PORT|outTables|0":"|Output table 1|Output tables"},"portMappings":[{"portName":"outTables","mappingType":"tableStructure","tableStructure":{}}],"arguments":{"codeOptions":{"code":"%let path=/home/student/Data;\r\nlibname imdb \"&path\";","contentType":"embedded","variables":[{"name":"_input1","value":{"portIndex":0,"portName":"inTables","referenceType":"inputPort"}},{"name":"_output1","value":{"arguments":{},"portIndex":0,"portName":"outTables","referenceType":"outputPort"}}]}},"stepReference":{"type":"ur