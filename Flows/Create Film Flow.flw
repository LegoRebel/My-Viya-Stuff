dLength":0,"indexed":false}]}}],"arguments":{"codeOptions":{"code":"data IMDB.BOX_OFFICE_1000_final (drop=fmtname start label  ) urlfmt (keep=fmtname start label);\r\nset WORK.allfilms_link (rename=(\"Domestic %\"n=a\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\"Domestic Lifetime Gross\"n=b\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\"Foreign %\"n =c \"Foreign Lifetime Gross\"n=d\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\"Worldwide Lifetime Gross\"n=e\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\trank=ranktemp\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tyear=yearchar\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tLinks=L));\r\nlength tconst $ 10;\r\nretain fmtname \"$url\";\r\nlabel=cats(\"https://www.boxofficemojo.com/\",l);\r\nlink=label;\r\n*title=catt(title,\" (\",year,\")\");\r\nstart=title;\r\ntconst=scan(l,2,\"/\");\r\nUS_pct=input(a,percent8.);\r\nUS_Lifetime_Gross =input(b,comma14.);\r\nRest_world_pct=input(c,percent8.);\r\nRest_world_Gross=input(d,comma14.);\r\nWorldwide_Lifetime_Gross=input(e,comma14.);\r\ndrop e--c l ranktemp yearchar;\r\nformat US_Lifetime_Gross Rest_world_Gross Worldwide_Lifetime_Gross dollar16.  \r\nUS_pct\tRest_world_pct percent8.1;\r\nrank=input(ranktemp,comma5.);\r\nlabel Rank=\"Box Office Ranking\" \r\n\t\tUS_Lifetime_Gross=\"US Lifetime Gross\" ;\r\nyear=input(yearchar,4.);\r\n*decade=int(year/10)*10;\r\nrun;\r\n","contentType":"embedded","variables":[{"name":"_input1","value":{"portIndex":0,"portName":"inTables","referenceType":"inputPort"}},{"name":"_output1","value":{"arguments":{},"portIndex":0,"portName":"outTables","referenceType":"outputPort"}}]}},"stepReference":{"type":"uri","path":"/dataFlows/steps/a7190700-f59c-4a94-afe2-214ce639fcde"}}},"parameters":{"3ce1fe20-2460-11f1-8c2e-4b25bc84b893":{"id":"3ce1fe20-2460-11f1-8c2e-4b25bc84b893","name":"ALLFILMS_LINK","defaultValue":{"table":{"creationTimeStamp":"2026-10-20T09:39:41.578Z","modifiedTimeStamp":"2026-10-20T09:39:41.578Z","version":3,"name":"ALLFILMS_LINK","providerId":"Compute","dataSourceId":